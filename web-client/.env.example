# Copy to .env.local for `npm run dev` against a deployed Cognito pool.
# .env* is gitignored. (The Docker image gets these as build args instead.)
#
# NOTE: everything prefixed VITE_ is INLINED INTO THE BROWSER BUNDLE at build
# time. Never put a secret here. A Cognito app-client id is a public
# identifier by design; an API key or client secret is not.
#
# The API is always same-origin (/api), so there is no API URL to set.

# ---- Auth ----
# none    = backend running under the `dev` Spring profile (no sign-in screen)
# cognito = real sign-in against an AWS Cognito user pool
VITE_AUTH_MODE=none

# Required when VITE_AUTH_MODE=cognito. Read them from the CloudFormation
# outputs of the 03-cognito stack:
#   aws cloudformation describe-stacks --stack-name calorietracker-cognito \
#     --query 'Stacks[0].Outputs'
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# ---- Dev server only ----
# Where `npm run dev` proxies /api to (the local gateway from `make up`).
VITE_API_PROXY_TARGET=http://localhost:8080
