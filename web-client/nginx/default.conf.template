# Web client nginx config (envsubst-rendered at container start). Plain HTTP
# on 8080 everywhere; TLS is CloudFront's job on AWS. Locally nginx also
# proxies /api to the gateway; on AWS the load balancer routes /api itself.

# Caching as a map, not per-location add_header: an add_header inside a
# location drops every server-level one (CSP included).
map $uri $ct_cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";   # content-hashed
    default     "no-store, must-revalidate";             # index.html must never go stale
}

# HSTS only when the browser leg was HTTPS.
map $http_x_forwarded_proto $ct_hsts {
    https   "max-age=31536000";
    default "";
}

# CloudFront reports the browser's TLS version; the free *.cloudfront.net
# certificate still accepts TLS 1.0/1.1, so refuse those. No header = local.
map $http_cloudfront_viewer_tls $ct_tls_too_old {
    ""              0;
    ~^TLSv1\.[23]:  0;
    default         1;
}

# What to tell the gateway about the original scheme when proxying /api.
map $http_x_forwarded_proto $ct_forwarded_proto {
    ""      http;
    default $http_x_forwarded_proto;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    if ($ct_tls_too_old) {
        return 426;
    }

    # Security headers: server level, `always` (error pages too).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cache-Control $ct_cache_control always;
    add_header Strict-Transport-Security $ct_hsts always;   # empty = omitted
    # Only our own scripts; inline styles are needed by React style props and
    # Recharts. connect-src: our /api and Cognito sign-in only.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${COGNITO_IDP_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    client_max_body_size 256k;

    # /api proxy (local stack). The upstream is a variable so the name is
    # resolved per request: nginx starts before the gateway and survives its
    # restarts. With a variable, the URI must be appended explicitly.
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        resolver_timeout 5s;
        set $ct_api_upstream ${API_UPSTREAM};
        proxy_pass $ct_api_upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $ct_forwarded_proto;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Connection        "";

        # The gateway sends its own security headers; keep only nginx's.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Resource-Policy;
        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
        proxy_hide_header Expires;

        # AI calls can take a while.
        proxy_connect_timeout 10s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;

        proxy_buffering off;
    }

    # A missing bundle is a real 404, not index.html.
    location /assets/ {
        try_files $uri =404;
    }

    # Client-side routes (/day, /reports...) get the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }
}
